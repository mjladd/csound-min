#!/usr/bin/env bash
# csd - render .csd files, and build csound-min when you work on the engine.
#
# The helper runs in one of two modes.
#
# Engine mode: it runs from a csound-min checkout, or CSOUND_BUILD_DIR names a
# build tree. It uses the csound you built, with the loadable back ends in the
# build tree, and it can build. Until you build, it uses the released csound.
#
# Workspace mode: it runs anywhere else, for example in the workspace image of
# a music project. It uses the released csound in /usr/local, and it cannot
# build or run the difference test.
#
# Run 'csd help' for the subcommands.
set -euo pipefail

self=$(readlink -f "$0")
release=/usr/local/bin/csound

# A csound-min checkout, and not any other folder.
is_checkout() {
    [ -n "$1" ] && [ -f "$1/CMakeLists.txt" ] && [ -d "$1/src/Engine" ]
}

git_root() {
    git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true
}

# The helper sits in .devcontainer/bin of a checkout, or in /usr/local/bin of
# the workspace image. The current folder can also be in a checkout.
find_checkout() {
    local candidate
    for candidate in "$(cd "$(dirname "$self")/../.." && pwd)" "$(git_root)"; do
        if is_checkout "$candidate"; then
            echo "$candidate"
            return
        fi
    done
}

checkout=$(find_checkout)

if [ -n "${CSOUND_BUILD_DIR:-}" ]; then
    mode=engine
    build=$CSOUND_BUILD_DIR
    root=${checkout:-$PWD}
elif [ -n "$checkout" ]; then
    mode=engine
    root=$checkout
    build=$root/build
else
    mode=workspace
    root=$(git_root)
    root=${root:-$PWD}
    build=""
fi

if [ "$mode" = engine ]; then
    renders=$build/renders
else
    renders=$root/renders
fi

usage() {
    cat <<'TEXT'
usage: csd <command> [arguments]

  build                      compile the library, the program and the utilities
  render FILE.csd [OUT.wav]  render to a file, ignoring -odac in the .csd
  play FILE.csd              render, then play the result
  live FILE.csd              send the audio straight to the audio device
  analyze                    run analysis/make.sh, which makes the analysis files
  info FILE.wav              print the format, the length and the peak level
  opcodes [PATTERN]          list the opcodes the engine provides
  difftest                   compare the renders against the recorded baseline
  help                       print this text

In a csound-min checkout, the rendered files go to build/renders, and the
engine is the one you built. Set CSOUND_BUILD_DIR to use another build tree.
Anywhere else, the rendered files go to renders/ in your project, the engine
is the released one in /usr/local, and build and difftest do not run.
TEXT
}

engine_only() {
    echo "csd: '$1' needs a csound-min checkout." >&2
    echo "csd: this is $release, the released engine." >&2
    exit 2
}

need_build() {
    [ "$mode" = engine ] || engine_only build
    if [ ! -x "$build/csound" ]; then
        echo "csd: $build/csound is missing. Building it now." >&2
        cmd_build
    fi
}

cmd_build() {
    [ "$mode" = engine ] || engine_only build
    if [ ! -f "$build/CMakeCache.txt" ]; then
        cmake -S "$root" -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=Release
    fi
    ninja -C "$build" "$@"
}

# Runs the csound you built, or the released one until you build. Each engine
# needs its own loadable back ends, so the plugin folder follows the choice.
run_csound() {
    if [ -n "$build" ] && [ -x "$build/csound" ]; then
        OPCODE7DIR64=$build "$build/csound" "$@"
    elif [ -x "$release" ]; then
        env -u OPCODE7DIR64 "$release" "$@"
    else
        need_build
        OPCODE7DIR64=$build "$build/csound" "$@"
    fi
}

# Renders to a file. A -o flag on the command line overrides the -odac that
# most .csd files carry in their own <CsOptions> block.
render_to() {
    local input=$1 output=$2
    mkdir -p "$(dirname "$output")"
    run_csound -W -o "$output" "$input"
}

default_output() {
    echo "$renders/$(basename "${1%.*}").wav"
}

cmd_render() {
    [ $# -ge 1 ] || { usage; exit 2; }
    local output=${2:-$(default_output "$1")}
    render_to "$1" "$output"
    echo "wrote $output"
}

cmd_play() {
    [ $# -ge 1 ] || { usage; exit 2; }
    local output=${2:-$(default_output "$1")}
    render_to "$1" "$output"
    play_file "$output"
}

play_file() {
    local file=$1
    local socket=${PULSE_SERVER:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native}
    if [ -S "${socket#unix:}" ] && command -v paplay > /dev/null; then
        paplay "$file"
    elif [ -d /dev/snd ] && command -v play > /dev/null; then
        play -q "$file"
    elif [ -d /dev/snd ] && command -v aplay > /dev/null; then
        aplay -q "$file"
    else
        echo "csd: this container reaches no audio device, so nothing played." >&2
        echo "csd: play $file on the host, or read .devcontainer/README.md" >&2
        echo "csd: to mount the host audio socket." >&2
        return 1
    fi
}

cmd_live() {
    [ $# -ge 1 ] || { usage; exit 2; }
    run_csound -odac "$@"
}

# The analysis files of a music project come from its samples. The project
# keeps the commands in one script, so that anybody can make them again.
cmd_analyze() {
    local script=$root/analysis/make.sh
    if [ ! -f "$script" ]; then
        echo "csd: $script is missing, so there is nothing to make." >&2
        return 1
    fi
    ( cd "$root" && bash "$script" "$@" )
}

cmd_info() {
    [ $# -ge 1 ] || { usage; exit 2; }
    if ! command -v sox > /dev/null; then
        echo "csd: info needs sox, which the container installs." >&2
        return 1
    fi
    sox --i "$1"
    printf 'peak level     : '
    sox "$1" -n stat 2>&1 | sed -n 's/^Maximum amplitude: *//p'
}

cmd_opcodes() {
    if [ $# -ge 1 ]; then
        run_csound -z1 2>&1 | grep -i -- "$1"
    else
        run_csound -z1 2>&1
    fi
}

cmd_difftest() {
    [ "$mode" = engine ] || engine_only difftest
    need_build
    python3 "$root/src/tools/difftest.py" compare \
        --csound "$build/csound" --plugin-dir "$build" \
        --suite "$root/tests/soak" \
        --baseline "$root/tests/difftest-baseline.json" "$@"
}

command=${1:-help}
[ $# -gt 0 ] && shift || true

case $command in
    build)    cmd_build "$@" ;;
    render)   cmd_render "$@" ;;
    play)     cmd_play "$@" ;;
    live)     cmd_live "$@" ;;
    analyze)  cmd_analyze "$@" ;;
    info)     cmd_info "$@" ;;
    opcodes)  cmd_opcodes "$@" ;;
    difftest) cmd_difftest "$@" ;;
    help|-h|--help) usage ;;
    *)        echo "csd: unknown command '$command'" >&2; usage; exit 2 ;;
esac
